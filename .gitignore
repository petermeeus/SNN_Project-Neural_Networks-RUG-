# Local environment and secrets
.venv/
venv/
.env
.env.*
!.env.example

# Python caches, tests, and builds
/tests/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# Logs and operating system files
*.log
.DS_Store
Thumbs.db

# Local datasets; retain documentation and folder placeholders
/data/*
!/data/README.md
!/data/raw/
!/data/processed/
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Generated dataset caches
/cache/

# Generated model checkpoints
/checkpoints/*
!/checkpoints/.gitkeep
